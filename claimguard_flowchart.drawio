<mxfile host="app.diagrams.net"><diagram name="ClaimGuard AI flow" id="claimguard-flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="z_par" value="Run in parallel: asyncio.gather() starts the chosen workers at the same time (Python)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="760" width="940" height="350" as="geometry"/></mxCell><mxCell id="z_b" value="Part B (per our plan): writer, evaluator, output guardrail, protected tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1235" width="720" height="410" as="geometry"/></mxCell><mxCell id="lg" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="20" width="340" height="330" as="geometry"/></mxCell><mxCell id="lgb0" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1075" y="55" width="40" height="24" as="geometry"/></mxCell><mxCell id="lgt0" value="Person (human)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1125" y="55" width="260" height="24" as="geometry"/></mxCell><mxCell id="lgb1" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1075" y="90" width="40" height="24" as="geometry"/></mxCell><mxCell id="lgt1" value="Python code (NO LLM)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1125" y="90" width="260" height="24" as="geometry"/></mxCell><mxCell id="lgb2" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1075" y="125" width="40" height="24" as="geometry"/></mxCell><mxCell id="lgt2" value="LLM agent (the model decides)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1125" y="125" width="260" height="24" as="geometry"/></mxCell><mxCell id="lgb3" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1075" y="160" width="40" height="24" as="geometry"/></mxCell><mxCell id="lgt3" value="Tool (plain Python function)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1125" y="160" width="260" height="24" as="geometry"/></mxCell><mxCell id="lgb4" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1075" y="195" width="40" height="24" as="geometry"/></mxCell><mxCell id="lgt4" value="Data / database" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1125" y="195" width="260" height="24" as="geometry"/></mxCell><mxCell id="lgs" value="&lt;b&gt;7 LLM agents&lt;/b&gt; = 5 in Part A + 2 in Part B&lt;br&gt;&lt;b&gt;6 tools&lt;/b&gt; = 5 used by workers (3 + 1 + 1) + 1 protected tool&lt;br&gt;Solid arrow = flow of the claim&lt;br&gt;Dashed arrow = tool call / data access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1075" y="228" width="310" height="115" as="geometry"/></mxCell><mxCell id="customer" value="&lt;b&gt;Customer (claimant)&lt;/b&gt;&lt;br&gt;person" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="20" width="260" height="50" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Gradio UI&lt;/b&gt; (app.py) + trace() [B]&lt;br&gt;Python code" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="260" height="56" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;1. Input guardrail&lt;/b&gt;&lt;br&gt;check_input()&lt;br&gt;Python code (no LLM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="186" width="260" height="64" as="geometry"/></mxCell><mxCell id="intake" value="&lt;b&gt;2. Intake agent&lt;/b&gt;&lt;br&gt;LLM, no tools&lt;br&gt;returns IntakeExtraction" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="280" width="260" height="64" as="geometry"/></mxCell><mxCell id="pyintake" value="&lt;b&gt;3. Intake checks&lt;/b&gt;&lt;br&gt;retry once, find missing fields,&lt;br&gt;build ClaimFacts (Python code)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="374" width="260" height="64" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;4. Routing&lt;/b&gt;: risk_route()&lt;br&gt;explicit rules&lt;br&gt;Python code (no LLM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="468" width="260" height="64" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;5. Claim orchestrator&lt;/b&gt;&lt;br&gt;LLM, no tools&lt;br&gt;chooses which workers to run" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="562" width="260" height="64" as="geometry"/></mxCell><mxCell id="sanitize" value="&lt;b&gt;6. sanitize_plan()&lt;/b&gt;&lt;br&gt;only known workers, policy always&lt;br&gt;Python code (no LLM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="656" width="260" height="64" as="geometry"/></mxCell><mxCell id="w_pol" value="&lt;b&gt;7. Policy worker&lt;/b&gt;&lt;br&gt;LLM agent, 3 tool(s)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="820" width="260" height="60" as="geometry"/></mxCell><mxCell id="tc_pol" value="Policy tools (3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="810" width="600" height="80" as="geometry"/></mxCell><mxCell id="tc_pol_t0" value="get_customer_policy()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="844" width="180" height="36" as="geometry"/></mxCell><mxCell id="tc_pol_t1" value="get_policy_coverage()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="844" width="180" height="36" as="geometry"/></mxCell><mxCell id="tc_pol_t2" value="calculate_deductible() (pure math)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="844" width="180" height="36" as="geometry"/></mxCell><mxCell id="e1" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w_pol" target="tc_pol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_his" value="&lt;b&gt;7. History worker&lt;/b&gt;&lt;br&gt;LLM agent, 1 tool(s)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="930" width="260" height="60" as="geometry"/></mxCell><mxCell id="tc_his" value="History tool (1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="920" width="220" height="80" as="geometry"/></mxCell><mxCell id="tc_his_t0" value="check_claim_history()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="954" width="200" height="36" as="geometry"/></mxCell><mxCell id="e2" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w_his" target="tc_his"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w_doc" value="&lt;b&gt;7. Docs worker&lt;/b&gt;&lt;br&gt;LLM agent, 1 tool(s)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1040" width="260" height="60" as="geometry"/></mxCell><mxCell id="tc_doc" value="Docs tool (1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="1030" width="220" height="80" as="geometry"/></mxCell><mxCell id="tc_doc_t0" value="check_required_documents()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="1064" width="200" height="36" as="geometry"/></mxCell><mxCell id="e3" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w_doc" target="tc_doc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="db" value="data/mock_data.json&lt;br&gt;synthetic customers, policies, claim history, required documents" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1270" y="810" width="140" height="300" as="geometry"/></mxCell><mxCell id="e4" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tc_pol" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tc_his" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tc_doc" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="merge" value="&lt;b&gt;8. merge_evidence()&lt;/b&gt;&lt;br&gt;builds EvidenceBundle, failures become gaps&lt;br&gt;Python code (no LLM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="1145" width="260" height="64" as="geometry"/></mxCell><mxCell id="writer" value="&lt;b&gt;9. Claim writer [B]&lt;/b&gt;&lt;br&gt;LLM, no tools&lt;br&gt;returns ClaimSummary" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1265" width="260" height="64" as="geometry"/></mxCell><mxCell id="evaluator" value="&lt;b&gt;10. Evaluator [B]&lt;/b&gt;&lt;br&gt;LLM, no tools&lt;br&gt;returns EvaluationResult" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1365" width="260" height="64" as="geometry"/></mxCell><mxCell id="guardout" value="&lt;b&gt;11. Output guardrail [B]&lt;/b&gt;&lt;br&gt;check_output()&lt;br&gt;Python code (no LLM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="320" y="1465" width="260" height="64" as="geometry"/></mxCell><mxCell id="create" value="&lt;b&gt;12. create_claim_case()&lt;/b&gt; [B]&lt;br&gt;protected tool, Python code&lt;br&gt;validates arguments first" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="1565" width="260" height="64" as="geometry"/></mxCell><mxCell id="cases" value="SQLite cases table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="1565" width="200" height="64" as="geometry"/></mxCell><mxCell id="adjuster" value="&lt;b&gt;Human adjuster&lt;/b&gt; (claims reviewer / manager)&lt;br&gt;person: makes the final decision" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="320" y="1685" width="260" height="56" as="geometry"/></mxCell><mxCell id="alert" value="&lt;b&gt;Human review alert&lt;/b&gt;&lt;br&gt;escalate() [B], Python code&lt;br&gt;&lt;br&gt;Stops the automatic flow when:&lt;br&gt;• INPUT_BLOCKED&lt;br&gt;• INTAKE_FAILED / MISSING_INFORMATION&lt;br&gt;• router flags: HIGH_AMOUNT, POLICY_NOT_ACTIVE, INCIDENT_BEFORE_POLICY_START, SUSPICIOUS_HISTORY ...&lt;br&gt;• NeedsManual (still rejected after 3 rounds)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="230" height="360" as="geometry"/></mxCell><mxCell id="e7" value="claim text + customer_id + documents" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="customer" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="run_intake_and_evidence()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="ui" target="guard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="guard" target="intake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="IntakeExtraction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="intake" target="pyintake"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="ClaimFacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="pyintake" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="routine claim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="router" target="orch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="WorkerPlan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="orch" target="sanitize"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="approved plan" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="sanitize" target="z_par"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="3 results (evidence or error)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="z_par" target="merge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="EvidenceBundle (+ gaps)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="merge" target="writer"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="draft ClaimSummary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="writer" target="evaluator"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="revise, max 3 rounds (revision_loop.py, Python)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="evaluator" target="writer"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="305" y="1397"/><mxPoint x="305" y="1297"/></Array></mxGeometry></mxCell><mxCell id="e19" value="accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="evaluator" target="guardout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="passed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="guardout" target="create"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="case saved, status PENDING-ADJUSTER" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="create" target="adjuster"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="create" target="cases"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.078;entryDx=0;entryDy=0;" edge="1" parent="1" source="guard" target="alert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="failed / missing info" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="pyintake" target="alert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="high risk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.861;entryDx=0;entryDy=0;" edge="1" parent="1" source="router" target="alert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="NeedsManual" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="evaluator" target="alert"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="202" y="1416"/></Array></mxGeometry></mxCell><mxCell id="e27" value="alert shown to the adjuster" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;fontSize=11;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alert" target="adjuster"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="87" y="1713"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>